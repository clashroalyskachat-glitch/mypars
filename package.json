{
  "name": "nkse-schedule",
  "version": "1.0.0",
  "private": true,
  "description": "Расписание НКСЭ — статический сайт с офлайн-режимом",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i tailwind.src.css -o app.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i tailwind.src.css -o app.css --watch",
    "build": "npm run build:css"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}