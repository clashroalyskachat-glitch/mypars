{
  "name": "nkse-schedule",
  "version": "1.0.0",
  "private": true,
  "description": "Расписание НКСЭ — статический сайт с офлайн-режимом",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i tailwind.src.css -o src/css_architecture/00_structural.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i tailwind.src.css -o app.css --watch",
    "build": "node toolchain_foundry/compiler.esbuild.mjs && node toolchain_foundry/schedule_meta.mjs",
    "build:firebase": "npm run build && node toolchain_foundry/firebase_layout.mjs",
    "dev:messenger": "node messenger/dev-server.mjs",
    "deploy": "node toolchain_foundry/deploy.mjs",
    "deploy:firebase": "node toolchain_foundry/deploy.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "qrcode-generator": "^2.0.4",
    "tailwindcss": "3.4.17",
    "ws": "^8.22.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0"
  }
}
